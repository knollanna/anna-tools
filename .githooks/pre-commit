#!/bin/sh
# Blocks a commit that introduces real job-search data outside job/.
# Logic lives in scripts/check_job_leak.py — see that file for the why.
#
# This only runs if core.hooksPath points here. A fresh clone needs to
# opt in once:
#   git config core.hooksPath .githooks

exec python3 "$(git rev-parse --show-toplevel)/scripts/check_job_leak.py"
