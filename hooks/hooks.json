{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/session_init.py",
            "timeout": 10,
            "statusMessage": "Loading anna-tools context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/job_context_nudge.py",
            "timeout": 10,
            "statusMessage": "Checking job-search context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__2701e52f-b826-4aaf-8b25-11f2a97c98b0__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/guard_mcp_readonly.py",
            "timeout": 10,
            "statusMessage": "Checking Gmail read-only guardrail"
          }
        ]
      }
    ]
  }
}
